# Runtime configuration
# Local development examples are shown below. Set production values in the
# hosting provider's secret/environment-variable settings.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/JobBoard
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development
SESSION_COOKIE_SECURE=false
SQLALCHEMY_ECHO=false
# Render supplies PORT automatically; do not hard-code it in the application.

# JWT & Session
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
SESSION_SECRET=your_session_secret_here

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2 object storage (required by production uploads)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

# Email (Brevo SMTP; required for confirmation and application/status email tasks)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_username_here
SMTP_PASSWORD=your_brevo_smtp_key_here
MAIL_FROM=youremail@example.com

# Token Expiry
CONFIRMATION_TOKEN_EXPIRE_MINUTES=15
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/googleauth/google/callback
